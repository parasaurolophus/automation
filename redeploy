#!/bin/sh

# shell script to pull latest sources, build, and deploy

printf "\e[1;38;2;0;255;255mStopping automation-backend.service...\e[0m\n"
sudo systemctl stop automation-backend.service
sudo systemctl status automation-backend.service

printf "\n\e[1;38;2;0;255;255mPulling latest sources...\e[0m\n"
git pull

printf "\n\e[1;38;2;0;255;255mRefreshing backend dependencies...\e[0m\n"
cd automation-backend
npm i

printf "\n\e[1;38;2;0;255;255mRefreshing frontend dependencies...\e[0m\n"
cd ../automation-frontend
npm i; npm run cleanl; npm run build

printf "\n\e[1;38;2;0;255;255mStarting automation-backend.service...\e[0m\n"
cd ..
sudo systemctl start automation-backend.service
sudo systemctl status automation-backend.service

printf "\n\e[1;38;2;0;255;255mDone.\e[0m\n"
